# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube al repositorio (ver .gitignore).

# URL pública del sitio, usada en metadata/Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.volttechcr.com

# --- Integración de leads (formulario de contacto) ---
#
# El formulario de contacto envía cada lead a este webhook (ej. Power
# Automate, Make, Zapier, o un endpoint propio hacia Google Sheets/Excel).
# Si se deja vacío, el sitio funciona en "modo de prueba": el lead se
# guarda localmente en .data/leads.local.jsonl y se registra en consola,
# pero NO se envía a ningún lado. El usuario nunca ve un mensaje falso de
# "guardado" — solo confirmación de que su solicitud se recibió.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_METHOD=POST
# Token opcional si el webhook requiere autenticación Bearer.
LEAD_WEBHOOK_TOKEN=

# --- Vista interna/admin de la calculadora ---
# Password simple para ?admin=1 (sin seguridad robusta — solo para demos
# internas de Steve/German, nunca usar como control de acceso real).
NEXT_PUBLIC_CALCULATOR_ADMIN_KEY=volttech-admin
