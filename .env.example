# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube al repositorio (ver .gitignore).

# URL pública del sitio, usada en metadata/Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.boldagencycr.com

# --- Integración de leads con Excel Online / CRM ---
#
# El formulario de Diagnóstico 360 envía cada lead a este webhook.
# Si se deja vacío, el sitio funciona en "modo de prueba": el lead se
# guarda localmente en .data/leads.local.jsonl y se registra en consola,
# pero NO se envía a ningún lado. El usuario nunca ve un mensaje falso de
# "guardado en tu Excel" — solo confirmación de que su solicitud se recibió.
#
# Ver README.md → "Conectar con Excel Online" para instrucciones paso a
# paso de las 4 formas soportadas (Power Automate, Make, Zapier o un
# endpoint propio / Microsoft Graph).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_METHOD=POST
# Token opcional si tu webhook requiere autenticación Bearer.
LEAD_WEBHOOK_TOKEN=

# --- Aviso de leads por WhatsApp (CallMeBot) ---
#
# Envía un WhatsApp al dueño del negocio apenas entra un lead, en paralelo
# al webhook de arriba (no depende de que ese otro canal esté bien armado).
# Si se dejan vacías, este aviso simplemente no se envía.
# Ver README.md → "Aviso de leads por WhatsApp" para cómo conseguir el
# apikey (gratis, sin cuenta de WhatsApp Business).
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
